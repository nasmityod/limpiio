# Crontab de producción (root). TZ del sistema: America/Caracas.
# Instalar/actualizar con: scripts/install-crontab.sh
#
# APP_SLUG nombra esta instancia en el servidor: /var/www/<slug>,
# /etc/<slug>/<slug>.env y /var/log/<slug>-cron.log. cron exporta las
# asignaciones de este archivo al entorno del comando, y cada línea la ejecuta
# /bin/sh, así que $APP_SLUG se expande en rutas y redirecciones.
# Cámbialo aquí si la instancia se despliega con otro nombre.
APP_SLUG=storefront
# update-bcv-rate: 00:15, 01:15 y 05:15 TODOS los días.
#   - 00:15 caza la publicación de medianoche de la API.
#   - 01:15 y 05:15 son reintentos por si la fuente publica con retraso.
#   - El endpoint es idempotente: si la fecha de la API no cambió, responde
#     sinCambios y no escribe nada (seguro correr a diario, incl. fines de semana).
15 0,1,5 * * * /var/www/$APP_SLUG/scripts/run-bcv-cron.sh >> /var/log/bcv-cron.log 2>&1
0 */2 * * * /var/www/$APP_SLUG/scripts/run-cron-endpoint.sh abandoned-cart >> /var/log/$APP_SLUG-cron.log 2>&1
30 1 * * 0 /var/www/$APP_SLUG/scripts/run-cron-endpoint.sh purge-product-views >> /var/log/$APP_SLUG-cron.log 2>&1
# review-request (FASE 4.5): a las 10:00 — email de reseña 7 días tras 'Entregado' (uno por pedido, sin reenvíos).
0 10 * * * /var/www/$APP_SLUG/scripts/run-cron-endpoint.sh review-request >> /var/log/$APP_SLUG-cron.log 2>&1
# SESIÓN 07 — Purga unificada de datos temporales (una vez al día a las 03:00).
# Borra reset tokens, tokens de email, metadatos PaymentUpload DELETED (>30d), vistas y carritos abandonados
# según la política de retención. No borra pedidos ni comprobantes LINKED.
0 3 * * * /var/www/$APP_SLUG/scripts/run-cron-endpoint.sh purge-temporary-data >> /var/log/$APP_SLUG-cron.log 2>&1
# SESIÓN 05 — Purga horaria de PaymentUpload PENDING/UPLOADING expirados: borra objeto R2 y marca DELETED.
15 * * * * /var/www/$APP_SLUG/scripts/run-cron-endpoint.sh purge-payment-uploads >> /var/log/$APP_SLUG-cron.log 2>&1
# Cancelación automática de pedidos pendientes: cada 15 minutos, al superar 48 horas desde createdAt.
7,22,37,52 * * * * /var/www/$APP_SLUG/scripts/run-cron-endpoint.sh auto-cancel-orders >> /var/log/$APP_SLUG-cron.log 2>&1
