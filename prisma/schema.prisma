generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id              String         @id @default(cuid())
  name            String
  /// PRD-065: slug obligatorio (backfill en migración `prd_infra_datos_cache`).
  slug            String         @unique
  sku             String?        @unique
  description     String?
  /// PRD-204: Decimal(12,2) para evitar errores de redondeo binario en sumas.
  price           Decimal        @db.Decimal(12, 2)
  /// Costo base en USD (lo que el negocio paga). Usado para auto-calcular price.
  /// SENSIBLE: nunca exponer en catálogo/API pública. Solo selects admin.
  cost            Decimal?       @db.Decimal(12, 2)
  originalPrice   Decimal?       @db.Decimal(12, 2)
  /// Margen de ganancia % específico de este producto. Null = usar el margen global.
  /// Se usa para recalcular `price` desde `cost` al cambiar el factor BCV–Binance globalmente.
  profitMarginPct Decimal?       @db.Decimal(6, 2)
  /// Tasa BCV–Binance vigente cuando se fijó el precio. Usada para reescalar
  /// productos de precio manual al recalcular. Null = aún sin calibrar.
  priceBaseFactor Decimal?       @db.Decimal(6, 2)
  stock           Int            @default(0)
  /// PRD-124: categoría por nombre (string); enlazada a Category por slug/nombre en la app.
  category        String
  brand           String?
  images          String[]
  /// PRD-064/121: despublicar/soft-delete sin borrar — preserva carritos,
  /// historial de pedidos y URLs. DEPENDENCIA-01 (getProducts) / 02 (checkout)
  /// / 05 (admin): filtrar `isActive: true` en listados públicos y compra.
  isActive        Boolean        @default(true)
  /// true = MundoTech cubre el envío; false = cobro a destino. Default false:
  /// todos los productos existentes quedan en cobro a destino al migrar.
  freeShipping    Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  /// * Especificaciones técnicas: [{ name: string, value: string }]. Null = sin specs cargadas.
  specs           Json?
  media           ProductMedia[]
  views           ProductView[]
  reviews         Review[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  wishlistItems   WishlistItem[]

  @@index([category])
  @@index([isActive])
  /// Auditoría de rendimiento del Panel Admin — el inventario ordena siempre por
  /// ("createdAt" DESC, id DESC) y pagina con keyset sobre esa misma tupla.
  @@index([createdAt, id])
  /// Filtro por categoría + el mismo orden keyset (evita el top-N sort de todo
  /// el catálogo cuando el operador filtra por categoría).
  @@index([category, createdAt, id])
  /// Filtros «agotados» / «stock bajo» y los contadores COUNT(*) FILTER del
  /// encabezado del inventario.
  @@index([stock, createdAt])
  /// Buscador de productos del Gestor Home (`/api/admin/products/search`), que
  /// ordena por updatedAt DESC.
  @@index([updatedAt])
  /// NOTA: el índice GIN pg_trgm de búsqueda admin (name+sku+brand) es una
  /// expresión y no se puede declarar aquí; vive en la migración SQL
  /// `add_admin_performance_indexes` (igual que product_search_trgm_idx).
}

model ProductMedia {
  id        String           @id @default(cuid())
  productId String
  type      ProductMediaType
  url       String
  posterUrl String?
  sortOrder Int              @default(0)
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Category {
  id               String   @id @default(cuid())
  name             String   @unique
  slug             String   @unique
  imageUrl         String?
  isFeatured       Boolean  @default(false)
  order            Int      @default(0)
  /// P85: texto plano (sin HTML) editable desde admin. Usado en meta description,
  /// CollectionPage JSON-LD y el hero de la categoría. Null = fallback genérico.
  description      String?
  /// P85: título SEO opcional (≤ 70 chars). Usado en <title> y JSON-LD name.
  /// Null = se genera automáticamente a partir de `name`.
  seoTitle         String?
  /// TODO-MC-01 (cerrado): override del ID de categoría Google (taxonomía oficial).
  /// Si está definido, el feed usa este valor directamente; si es null, cae en
  /// el mapa automático de lib/google-product-categories.ts.
  googleCategoryId Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isFeatured])
}

model Promotion {
  id           String   @id @default(cuid())
  title        String
  subtitle     String?
  discountText String?
  imageUrl     String?
  bgColor      String   @default("#FFD700")
  link         String   @default("/productos")
  active       Boolean  @default(true)
  order        Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, order])
}

model Banner {
  id         String   @id @default(cuid())
  type       String
  imageUrl   String
  title      String?
  subtitle   String?
  label      String?
  ctaText    String?
  tagText    String?
  link       String?  @default("/productos")
  /// Punto focal para object-position del hero (recorte en móvil).
  focalPoint String?  @default("center")
  active     Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([type, active])
}

model User {
  id                        String               @id @default(cuid())
  email                     String               @unique
  password                  String
  name                      String?
  /// PRD-127: roles canónicos en MAYÚSCULAS ('CLIENT' | 'ADMIN').
  role                      String               @default("CLIENT")
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  /// PRD-173/240: timestamp del último cambio de contraseña. El callback JWT
  /// deriva la huella (pwv) del hash bcrypt; cuando el hash cambia la huella
  /// difiere y todas las sesiones activas se invalidan en ≤5 min.
  passwordChangedAt         DateTime?
  /// PRD-014/089: nuevo email pendiente de confirmar antes de ser promovido.
  pendingEmail              String?
  /// PRD-014/089: token de un solo uso enviado al nuevo correo (hash SHA-256).
  emailChangeToken          String?              @unique
  /// PRD-014/089: expiración del token de cambio de email (1 hora).
  emailChangeTokenExpiry    DateTime?
  /// RBAC: marca exactamente a un propietario con acceso total irrevocable vía UI.
  /// Solo puede marcarse directamente en Prisma; el índice único parcial
  /// "User_single_superadmin_key" impide que haya más de uno.
  isSuperAdmin              Boolean              @default(false)
  /// RBAC: permisos delegados del panel admin. Array vacío = ninguno.
  /// Superadmin ignora este array; su acceso viene de isSuperAdmin.
  adminPermissions          String[]             @default([])
  /// RBAC: timestamp del último cambio de permisos (para invalidación de caché/UX).
  permissionsUpdatedAt      DateTime?
  orders                    Order[]
  passwordResetTokens       PasswordResetToken[]
  reviews                   Review[]
  savedAddresses            SavedAddress[]
  abandonedCarts            AbandonedCart[]
  cart                      Cart?
  wishlistItems             WishlistItem[]
  permissionChangesAuthored PermissionAuditLog[] @relation("PermissionAuditActor")
  permissionChangesReceived PermissionAuditLog[] @relation("PermissionAuditTarget")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDITORÍA DE CAMBIOS DE PERMISOS
// ─────────────────────────────────────────────────────────────────────────────

/// Registro inmutable de cada cambio de permisos en el panel.
/// Creado en la misma transacción que el UPDATE de User.
/// Restrict en ambas FKs: no se puede borrar actor ni target si tienen entradas.
model PermissionAuditLog {
  id                String   @id @default(cuid())
  actorId           String
  targetUserId      String
  beforePermissions String[]
  afterPermissions  String[]
  targetRoleBefore  String
  targetRoleAfter   String
  createdAt         DateTime @default(now())
  actor             User     @relation("PermissionAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  target            User     @relation("PermissionAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// LIBRO DE DIRECCIONES
// ─────────────────────────────────────────────────────────────────────────────
model SavedAddress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  alias          String
  firstName      String
  lastName       String
  idNumber       String
  phoneNumber    String
  shippingMethod String  @default("tienda")
  mrwState       String?
  mrwOffice      String?
  officeAddress  String? // ZOOM: dirección física de la oficina (snapshot). MRW no la usa.
  officeCity     String? // ZOOM: ciudad de la oficina (snapshot). MRW no la usa.
  isDefault      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CASHEA — Sección 6 del documento maestro (docs/ENTREGABLE-CLIENTE/integracion-cashea.md)
// Transiciones válidas:
//   CREATED -> REDIRECTED -> RETURNED -> VERIFYING -> CONFIRMED
//   VERIFYING -> RETURNED            (verificación aún pendiente, reintentable)
//   any(no CONFIRMED) -> CANCEL_PENDING -> CANCELLED
//   CREATED/REDIRECTED/RETURNED -> EXPIRED   (por reserva vencida)
//   CREATED/REDIRECTED -> FAILED
// ─────────────────────────────────────────────────────────────────────────────
enum CasheaStatus {
  CREATED
  REDIRECTED
  RETURNED
  VERIFYING
  CONFIRMED
  CANCEL_PENDING
  CANCELLED
  FAILED
  EXPIRED
}

model Order {
  id                         String            @id @default(cuid())
  orderNumber                Int               @unique @default(autoincrement())
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  customerId                 String?
  customerName               String
  customerEmail              String?
  customerPhone              String?
  /// PRD-204: Decimal(12,2) — sin errores de redondeo binario en totales acumulados.
  total                      Decimal           @db.Decimal(12, 2)
  /// PRD-122: valores válidos = OrderStatus de lib/definitions.ts. No se puede usar
  /// enum Prisma sin romper runtime de 02/05 ('En Proceso' y 'Pendiente verificación
  /// Binance' llevan espacios → el cliente devolvería otros literales). La migración
  /// `prd_infra_datos_cache` añade CHECK "Order_status_valid" a nivel de BD.
  status                     String            @default("Pendiente")
  paymentMethod              String
  /// ID estable del método de pago (snapshot). Null en pedidos antiguos.
  paymentMethodId            String?
  /// Subtotal original de líneas en Bs antes de descuentos. Null = legacy.
  subtotalBeforeDiscount     Decimal?          @db.Decimal(12, 2)
  /// Porcentaje de descuento por divisas congelado al crear. Null si no aplicó.
  paymentDiscountPercent     Decimal?          @db.Decimal(5, 2)
  /// Monto del descuento por divisas en Bs. Null si no aplicó.
  paymentDiscount            Decimal?          @db.Decimal(12, 2)
  /// Moneda elegida (p. ej. efectivo USD/EUR). Null si no aplica.
  paymentCurrency            String?
  shippingAddress            String
  shippingCity               String
  shippingState              String
  shippingZipCode            String            @default("N/A")
  shippingCountry            String            @default("Venezuela")
  customerIdNumber           String?
  paymentBank                String?
  paymentHolderIdNumber      String?
  paymentHolderPhone         String?
  paymentReference           String?
  paymentProofUrl            String?
  /// Fase 1 (Sesión 04): key del objeto en el bucket privado R2_PRIVATE_BUCKET_NAME.
  /// Compatibilidad legacy: coexiste con paymentProofUrl durante una fase.
  paymentProofKey            String?
  notes                      String?
  shippedAt                  DateTime?
  trackingCarrier            String?
  trackingNumber             String?
  trackingPhotoUrl           String?
  trackingUrl                String?
  /// * Tasa Bs/USD usada al crear el pedido. Si es null, `total` e ítems están en USD (pedidos antiguos).
  /// PRD-204: Decimal(12,4) para preservar decimales significativos de la tasa.
  exchangeRateUsdBs          Decimal?          @db.Decimal(12, 4)
  /// * Fecha en que se validó el pago (Validar Pago / equivalente). Para reportes por día de cobro.
  paidAt                     DateTime?
  /// /** Código del cupón aplicado al pedido (en mayúsculas). Null si no se usó cupón.
  couponCode                 String?
  /// * Descuento aplicado por el cupón, en Bs (misma moneda que `total`). PRD-204: Decimal.
  couponDiscount             Decimal?          @db.Decimal(12, 2)
  /// * Motivo de rechazo del pago, si el pedido fue cancelado por pago no válido.
  paymentRejectionReason     String?
  /// /** Email del admin que validó o rechazó el pago. Para trazabilidad.
  paymentVerifiedBy          String?
  /// FASE 4.5 (MEJORA 2.2): fecha en que el pedido pasó a 'Entregado'. Base para
  /// el cron review-request (email a los 7 días). Null en pedidos antiguos —
  /// el cron cae a updatedAt como aproximación.
  deliveredAt                DateTime?
  /// FASE 4.5: fecha del email de solicitud de reseña. Null = aún no enviado;
  /// evita reenvíos (un solo toque, sin incentivo).
  reviewRequestSentAt        DateTime?
  /// Canal de origen del pedido: "web" (checkout completo) o "whatsapp" (modo WhatsApp).
  channel                    String            @default("web")
  /// SESIÓN 06: hash SHA-256 del token de acceso guest. Solo pedidos sin
  /// cuenta (customerId = null) pueden tenerlo. @unique para lookup eficiente.
  guestAccessTokenHash       String?           @unique
  /// SESIÓN 06: fecha de expiración del guestAccessTokenHash. 72 h desde la
  /// creación. null si el pedido no tiene token (autenticado o legacy).
  guestAccessTokenExpiresAt  DateTime?
  /// true = las unidades continúan descontadas/reservadas.
  /// false = no fueron descontadas (p. ej. WhatsApp pendiente) o ya fueron
  /// liberadas al cancelar (marca atómica de reposición: true → false una sola vez).
  stockDeducted              Boolean           @default(true)
  /// Snapshot calculado al crear el pedido (dentro de la misma transacción del
  /// checkout). true SOLO cuando el método de envío es MRW/ZOOM/TEALCA y TODOS
  /// los productos calificaban para envío gratis en ese momento. `tienda`
  /// (retiro) nunca guarda true aquí — ver lib/shipping-charge.ts. Nunca se
  /// recalcula después de creado: los pedidos históricos no cambian si un
  /// producto cambia su beneficio más adelante.
  freeShipping               Boolean           @default(false)
  /// Cashea (Sección 6/10 del documento maestro): null = pedido no-Cashea.
  /// Campos opcionales — no rompen filas existentes. Aún no se usan en lógica
  /// (Fase 2 de la integración: solo esquema + migración).
  casheaStatus               CasheaStatus?
  /// idNumber devuelto por Cashea al crear la orden remota.
  casheaOrderId              String?           @unique
  /// Hash del token de retorno de un solo uso (nunca se guarda el token en claro).
  casheaReturnTokenHash      String?
  casheaInitialAmount        Decimal?          @db.Decimal(18, 2)
  casheaCurrency             String?
  /// Fin de la ventana de reserva de inventario (60 min por defecto). No se
  /// autocancela al vencer — solo marca EXPIRED (recuperación manual).
  casheaReservationExpiresAt DateTime?
  casheaRedirectedAt         DateTime?
  casheaReturnedAt           DateTime?
  /// Se fija SOLO tras verificación autoritativa exitosa (verifyCasheaOrder).
  casheaConfirmedAt          DateTime?
  casheaCancelledAt          DateTime?
  casheaLastResponseCode     String?
  casheaAttemptCount         Int               @default(0)
  couponRedemption           CouponRedemption?
  customer                   User?             @relation(fields: [customerId], references: [id])
  paymentUpload              PaymentUpload?
  items                      OrderItem[]

  @@index([customerId])
  @@index([status])
  /// PRD-195: índice compuesto para paginación cursor (createdAt DESC, id DESC).
  /// El `id` es discriminante de tie-break cuando varias filas comparten createdAt.
  @@index([createdAt, id])
  @@index([paidAt])
  /// Sesión 13: filtros operativos (status + createdAt) y de ingreso (status + paidAt).
  @@index([status, createdAt])
  @@index([status, paidAt])
  /// PRD-125: lookups de pedidos por email (guest, soporte, cron) sin full scan.
  @@index([customerEmail])
  /// Cashea: recuperación manual / cron de reconciliación por estado.
  @@index([casheaStatus])
  /// Cashea: cron de reconciliación para reservas vencidas (EXPIRED).
  @@index([casheaReservationExpiresAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  productName  String
  quantity     Int
  /// PRD-204: Decimal(12,2).
  price        Decimal @db.Decimal(12, 2)
  imageUrl     String?
  /// Snapshot del beneficio que tenía el producto al crear el pedido (no se
  /// vuelve a consultar el producto actual para pedidos ya creados).
  freeShipping Boolean @default(false)
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// PRD-123: FK real hacia Product. Restrict = no se puede borrar (hard-delete)
  /// un producto con historial de pedidos — usar `isActive: false` (soft-delete).
  /// Preserva la auditoría financiera. DEPENDENCIA-05: deleteProductAction debe
  /// mostrar error amable / ofrecer despublicar.
  product      Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model AppConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ProductView {
  id         String   @id @default(cuid())
  productId  String
  sessionId  String?
  viewBucket String
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sessionId, productId, viewBucket])
  @@index([productId])
  @@index([createdAt])
}

model Review {
  id               String       @id @default(cuid())
  productId        String
  userId           String?
  authorName       String
  rating           Int
  title            String?
  comment          String
  /// PRD-122: enum nativo — los literales 'PENDING'/'APPROVED'/'REJECTED' no
  /// cambian en runtime, así que el resto de segmentos compila sin cambios.
  status           ReviewStatus @default(PENDING)
  verifiedPurchase Boolean      @default(false)
  adminReply       String?
  photos           String[]     @default([])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// PRD-217: SetNull explícito — borrar un usuario anonimiza sus reseñas
  /// (queda authorName) en vez de bloquear o perder el historial.
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([status])
  @@index([createdAt])
  /// Moderación admin: pestañas Pendientes/Aprobadas/Rechazadas ordenadas por
  /// fecha. Sin este compuesto la lista paginada filtraba tras recorrer el
  /// índice de createdAt.
  @@index([status, createdAt])
}

model Coupon {
  id            String             @id @default(cuid())
  code          String             @unique
  description   String?
  discountType  String
  /// PRD-204: Decimal(12,2).
  discountValue Decimal            @db.Decimal(12, 2)
  /// * Compra mínima en USD (subtotal) para que aplique el cupón.
  minPurchase   Decimal            @default(0) @db.Decimal(12, 2)
  /// * Tope máximo de descuento en USD (solo aplica a PERCENT). Null = sin tope.
  maxDiscount   Decimal?           @db.Decimal(12, 2)
  /// * Usos totales permitidos. Null = ilimitado.
  maxUses       Int?
  usedCount     Int                @default(0)
  /// * Usos máximos por usuario registrado. Null = sin límite por usuario.
  perUserLimit  Int?
  startsAt      DateTime?
  expiresAt     DateTime?
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  redemptions   CouponRedemption[]

  @@index([active])
}

model CouponRedemption {
  id          String    @id @default(cuid())
  couponId    String
  orderId     String    @unique
  userId      String?
  /// * Slot 1..perUserLimit por usuario; impide canjes concurrentes duplicados.
  perUserSlot Int?
  /// * Descuento aplicado, en Bs (misma moneda que Order.total). PRD-204: Decimal.
  discount    Decimal   @db.Decimal(12, 2)
  /// * Marca de auditoría al revertir canje (cancelación); null = canje activo.
  revertedAt  DateTime?
  createdAt   DateTime  @default(now())
  coupon      Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Índice único parcial (couponId, userId, perUserSlot) WHERE revertedAt IS NULL:
  // ver migración 20260614170000_coupon_redemption_partial_unique_index.
  @@index([couponId])
  @@index([userId])
}

model RestockSubscription {
  id         String    @id @default(cuid())
  email      String
  productId  String
  /// * Fecha en que se envió el aviso. Null = aún pendiente.
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([email, productId])
  @@index([productId, notifiedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// CARRITO ABANDONADO
// status: 'PENDING' | 'EMAILED_24H' | 'EMAILED_72H' | 'RECOVERED' | 'OPTED_OUT'
// ─────────────────────────────────────────────────────────────────────────────
model AbandonedCart {
  id                String    @id @default(cuid())
  email             String
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Items serializados: AbandonedCartItem[] { id, name, slug, price, quantity, image }
  items             Json
  /// PRD-204: Decimal(12,2).
  totalUsd          Decimal   @db.Decimal(12, 2)
  /// PRD-178: SHA-256 (hex) del token de recuperación/opt-out. El token en claro
  /// solo existe en el email enviado; se genera y rota en lib/abandoned-cart.ts.
  recoveryTokenHash String    @unique
  status            String    @default("PENDING")
  /// Fecha del último email de abandono enviado.
  emailSentAt       DateTime?
  /// Última vez que se actualizó el carrito (se usa como T0 para la ventana de 24h/72h).
  lastActivityAt    DateTime  @default(now())
  recoveredAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([email, status])
  @@index([status, lastActivityAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// CARRITO PERSISTENTE (sincronizado con cuenta)
// ─────────────────────────────────────────────────────────────────────────────
model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

/// FASE 4.6 (MEJORA 3.2): wishlist persistida por cuenta. Al iniciar sesión se
/// fusiona (unión sin duplicados) con la lista local de localStorage.
/// Cascade en ambas FKs: borrar usuario o producto limpia sus favoritos
/// (la wishlist no es historial financiero — sin valor de auditoría).
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  /// PRD-232: antes Cascade — borrar un producto vaciaba ítems de carritos de
  /// clientes sin aviso. Restrict bloquea el hard-delete si hay carritos con el
  /// producto: el flujo correcto es despublicar (`isActive: false`).
  /// DEPENDENCIA-05: deleteProductAction debe manejar el error y sugerirlo.
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

enum ProductMediaType {
  IMAGE
  VIDEO
}

model VideoJob {
  id        String   @id @default(cuid())
  status    String   @default("PROCESSING") // PROCESSING | READY | FAILED
  videoUrl  String
  posterUrl String?
  width     Int?
  height    Int?
  durationS Int?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// PRD-122: estados de moderación de reseñas (coincide 1:1 con ReviewStatus de
/// lib/definitions.ts — mismos literales en runtime).
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────────────────────────────────────
// SESIÓN 05 — Upload de comprobantes con token efímero
// ─────────────────────────────────────────────────────────────────────────────
enum PaymentUploadStatus {
  PENDING
  UPLOADING
  LINKED
  DELETING
  DELETED
}

/// Token de upload de comprobante de pago. Se genera en /api/checkout/upload-session,
/// se consume en /api/checkout/upload-proof y se vincula al pedido en el checkout.
/// Los PENDING expirados se limpian por cron (purge-payment-uploads).
///
/// Estados:
///  - PENDING:  token disponible o comprobante ya subido, pendiente de vincular.
///  - UPLOADING: una request reclamó el token y está subiendo el objeto.
///  - LINKED:    el comprobante quedó vinculado a un pedido.
///  - DELETING:  un cron reclamó el registro para eliminarlo.
///  - DELETED:   el objeto fue eliminado o el registro expirado quedó procesado.
model PaymentUpload {
  id        String              @id @default(cuid())
  /// SHA-256 del token raw (único). El token en claro solo existe en la respuesta
  /// del endpoint que lo genera y en la request del cliente.
  tokenHash String              @unique
  /// Object key en bucket privado R2. Null mientras PENDING (antes del upload).
  objectKey String?             @unique
  status    PaymentUploadStatus @default(PENDING)
  /// User ID opcional para correlación (no es obligatorio para invitados).
  userId    String?
  /// Order ID vinculado. Se asigna al crear el pedido (LINKED). Unique: un
  /// comprobante solo puede vincularse a un pedido.
  orderId   String?             @unique
  order     Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// El token expira a los 30 minutos de creado. Después de expiry, el cron
  /// lo purga (borra R2 y marca DELETED).
  expiresAt DateTime
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  /// Índice para búsqueda eficiente de expirados (cron de purga).
  @@index([status, expiresAt])
  /// Índice para correlación por usuario (opcional).
  @@index([userId])
}
