# ════════════════════════════════════════════════════════════════════════
# PLATAFORMA DE ECOMMERCE — Variables de entorno
# Copia este archivo a .env (local/VPS) y completa los valores reales.
# NUNCA subas .env a git.
# NUNCA uses prefijo NEXT_PUBLIC_ para secretos (API keys, tokens, passwords).
# ════════════════════════════════════════════════════════════════════════

# ── Identidad de marca (config/brand.ts) ─────────────────────────────────
# Fuente única de la identidad visible: nombre, metadatos SEO, asuntos de
# correo y datos de contacto. Todas son NEXT_PUBLIC_ (viajan al navegador):
# nunca pongas secretos en este bloque.
# Salvo NEXT_PUBLIC_BRAND_NAME, si las dejas vacías la app arranca con textos
# neutros en vez de heredar la marca de otro proyecto. Requieren rebuild para
# propagarse.
#
# Nombre comercial visible. OBLIGATORIO en producción: lib/env-validation.ts
# lanza al arrancar el servidor si falta. Sin ella los asuntos de los correos
# salen como "Tienda · ...", y el <title>, el JSON-LD y la imagen OG quedan
# genéricos — un fallo silencioso que se descubre cuando el primer cliente ya
# recibió el correo. En desarrollo y en tests se degrada al default "Tienda".
NEXT_PUBLIC_BRAND_NAME=
# Razón social para textos legales. Si falta, se usa NEXT_PUBLIC_BRAND_NAME.
NEXT_PUBLIC_BRAND_LEGAL_NAME=
# Descriptor corto para metadatos y correos. Si falta, se omite.
NEXT_PUBLIC_BRAND_TAGLINE=
# Correo de soporte técnico. Si falta, se usa NEXT_PUBLIC_CONTACT_EMAIL.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Perfil de TikTok (opcional).
NEXT_PUBLIC_TIKTOK_URL=
# El resto de datos de marca se define más abajo, junto a su bloque temático:
#   NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_CONTACT_EMAIL, NEXT_PUBLIC_CONTACT_PHONES,
#   NEXT_PUBLIC_STORE_ADDRESS, NEXT_PUBLIC_INSTAGRAM_HANDLE y las redes sociales.

# ── Protección de las pruebas E2E ────────────────────────────────────────
# Host de PRODUCCIÓN contra el que Playwright debe negarse a ejecutar pruebas
# (playwright.config.ts aborta si PLAYWRIGHT_BASE_URL lo contiene). La guarda es
# FAIL-SAFE: la ausencia de configuración aborta, nunca permite.
#   con valor  → se usa este host.
#   vacío      → se deriva del hostname de NEXT_PUBLIC_SITE_URL.
#   sin ninguna de las dos → solo se admiten hosts locales (localhost,
#                            127.0.0.1, 0.0.0.0, ::1); cualquier host remoto aborta.
# Declarar tu dominio real es, además, lo que autoriza a lanzar los E2E contra
# un VPS de staging (host remoto que no coincide con el prohibido).
E2E_FORBIDDEN_HOST=

# ── Identificador de la instancia (infraestructura) ──────────────────────
# Slug corto en minúsculas que nombra ESTA instancia en el servidor: servicio
# systemd/PM2, /var/www/<slug>, /etc/<slug>/, sitio nginx, logs y buckets R2.
# Lo consumen los scripts de deploy/backup/crontab; si no se define usan
# "storefront". No lleva NEXT_PUBLIC_: no es dato de navegador.
APP_SLUG=storefront

# ── Base de datos (OBLIGATORIO) ──────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# Conexión directa a Postgres (sin PgBouncer). Obligatoria para `prisma migrate deploy`.
# Si usas pooler en DATABASE_URL (ej. ?pgbouncer=true), DIRECT_URL debe apuntar al puerto nativo 5432.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# ── NextAuth (OBLIGATORIO) ───────────────────────────────────────────────
# Genera un secret aleatorio: openssl rand -base64 32
NEXTAUTH_SECRET=cambia-esto-por-un-secret-aleatorio-de-32-chars
# URL pública de tu app (sin / final). En dev: http://localhost:3000
# En producción: https://tu-dominio.com
NEXTAUTH_URL=http://localhost:3000

# Modo de compra server-side. whatsapp permite guest y redirige a WhatsApp.
# full exige sesión y usa checkout completo con comprobante.
# En producción es obligatorio. No usar NEXT_PUBLIC_.
CHECKOUT_MODE=whatsapp

# ── Migración one-shot de imágenes legacy → R2 (opcional) ───────────────
# Hostname del CDN anterior cuyas URLs aún están en BD. Solo para:
#   npm run db:migrate:images -- --dry-run
# LEGACY_IMAGE_CDN_HOST=

# ── Cloudflare R2 — obligatorio para subir imágenes, opcional para entrar al panel ─
# Endpoint S3 de escritura (solo subida; NO es la URL pública de lectura).
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=storefront-media
# Dominio público de lectura (r2.dev o custom domain en Cloudflare). Sin slash final.
R2_PUBLIC_BASE_URL=https://cdn.tu-dominio.com
# Mismo valor que R2_PUBLIC_BASE_URL — necesario para validar URLs en el admin (Client Components).
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://cdn.tu-dominio.com

# ── Cloudflare R2 privado — comprobantes de pago ─────────────────────────────
# Credenciales S3 de un token R2 con Object Read & Write limitado
# exclusivamente al bucket privado. Nunca uses NEXT_PUBLIC_.
# SEC-2026-09: también recibe los backups de PostgreSQL (scripts/backup-postgres.sh).
# Debe ser DISTINTO del bucket público (R2_BUCKET_NAME).
R2_PRIVATE_BUCKET_NAME=storefront-private
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=

# ── Resend — correos transaccionales (RECOMENDADO; sin ellas no se envían emails) ─
# Solo servidor; nunca NEXT_PUBLIC_. https://resend.com/api-keys
# Si faltan, lib/resend.tsx omite el envío con log (no tumba la app).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Remitente verificado en Resend. DEBE ser un dominio propio de la tienda
# (mejora la entregabilidad y evita que los correos parezcan spam). Se usa como
# "From" en todos los correos. Acepta solo el correo (se antepone el nombre de
# marca de NEXT_PUBLIC_BRAND_NAME) o el formato completo
# "Mi Tienda <noreply@tu-dominio.com>".
# Dominio verificado en Resend (https://resend.com/domains):
RESEND_FROM_ADDRESS=noreply@tu-dominio.com
# Correo de atención real: se usa como Reply-To en los correos y como contacto público.
NEXT_PUBLIC_CONTACT_EMAIL=ventas@tu-dominio.com

# ── Despliegue — proxy y entorno (OBLIGATORIO en producción) ─────────────
# Controla cómo se extrae la IP real del cliente para rate limiting.
# Valores: "cloudflare" (VPS con Cloudflare y nginx con real_ip) | "vercel"
# En producción DEBE estar configurado; sin proxy de confianza las IPs de
# cliente son falsificables y el rate limiting es evadible. La app lanza al
# arrancar si NODE_ENV=production y DEPLOYMENT_ENV falta o es inválido.
# Para Vercel: DEPLOYMENT_ENV=vercel. Para el VPS detrás de Cloudflare:
# DEPLOYMENT_ENV=cloudflare
DEPLOYMENT_ENV=vercel

# ── Upstash Redis (OBLIGATORIO en producción) ──────────────────────────────
# Sin esto, el rate limiting cae al fallback en memoria del proceso: cada
# `pm2 restart`/deploy borra los contadores de fuerza bruta (login, reset de
# contraseña, cupones, etc). lib/env-validation.ts falla el arranque en
# producción si faltan. https://console.upstash.com → crear base de datos Redis
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxx

# ── Binance Pay (comercio) ───────────────────────────────────────────────
# https://merchant.binance.com → Developers → API
# BINANCE_PAY_API_KEY=
# BINANCE_PAY_API_SECRET=
# ID de recepción visible en el checkout del cliente
# NEXT_PUBLIC_BINANCE_PAY_ID=
# URL del código QR de Binance (imagen pública)
# NEXT_PUBLIC_BINANCE_QR_URL=
# Opcional: solo si Binance te indica otro host
# BINANCE_PAY_BASE_URL=https://bpay.binanceapi.com
# Moneda fiat para el cobro (USD recomendado)
# BINANCE_PAY_FIAT_CURRENCY=USD

# ── OAuth Google (opcional) ──────────────────────────────────────────────
# Si faltan, el botón "Continuar con Google" no aparece en /login.
# Consola: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Redes sociales (opcionales) ────────────────────────────────────────
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/tu_cuenta
# NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/tu_pagina
# NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/<codigo_pais><numero_sin_cero>

# ── URL pública del sitio (OBLIGATORIO en producción) ────────────────────
# Sin / final. Usada en canonicals, sitemap, OG y enlaces en correos.
# lib/env-validation.ts lanza al arrancar el servidor si falta: sin ella
# config/brand.ts cae a http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# ── Google Search Console (recomendado en producción) ────────────────────
# Código del meta tag de verificación (Search Console → Propiedad → Verificación
# por etiqueta HTML). Solo el valor del atributo content, no la etiqueta entera.
# Si falta, el meta de verificación no se emite (no afecta al resto del SEO).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Email de contacto público ────────────────────────────────────────────
# NEXT_PUBLIC_CONTACT_EMAIL=ventas@tu-dominio.com

# ── Google Maps ─────────────────────────────────────────────────────────
# NEXT_PUBLIC_GOOGLE_MAPS_BUSINESS_URL=https://www.google.com/maps/place/...
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=...

# ── Google Analytics 4 (opcional) ────────────────────────────────────────
# gtag.js se carga con Consent Mode v2 (todo denegado por defecto); los eventos
# de e-commerce (view_item, add_to_cart, begin_checkout, purchase, etc. —
# lib/ga4.ts) son no-op si esta variable falta.
# CÓMO ACTIVARLO: 1) crea una propiedad GA4 en https://analytics.google.com
# (Administrar → Crear propiedad → flujo de datos Web → tu-dominio.com),
# 2) copia el "ID de medición" (G-XXXXXXXXXX), 3) añádelo aquí y en el .env
# del VPS, 4) rebuild + deploy (es variable NEXT_PUBLIC_, va en el bundle).
# NEXT_PUBLIC_GA4_ID=

# ── Meta (Facebook) Pixel — seguimiento de anuncios FB/IG (opcional) ─────
# Pixel ID desde Events Manager → Fuentes de datos → tu pixel.
# Se carga solo tras aceptar cookies (CookieConsent). Sin la variable, no-op.
# Rebuild + deploy tras cambiarla (NEXT_PUBLIC_ va en el bundle).
# NEXT_PUBLIC_META_PIXEL_ID=

# ── IndexNow — indexación instantánea Bing/Yandex (opcional) ─────────────
# Genera una clave hex de 32 chars (openssl rand -hex 16). El sitio la sirve
# en /indexnow.txt y las mutaciones de catálogo hacen ping automático.
# Sin la variable, todo es no-op.
# INDEXNOW_KEY=

# ── Cloudflare — purga de caché post-deploy (opcional, recomendado) ─────
# Si ambas existen (en /etc/$APP_SLUG/$APP_SLUG.env del VPS), scripts/deploy-vps.sh
# purga la caché de la zona tras cada deploy para que ningún HTML viejo quede
# apuntando a chunks retirados. Token con permiso "Zone → Cache Purge".
# CF_ZONE_ID=
# CF_API_TOKEN=

# ── Cron jobs (OBLIGATORIO en producción VPS) ───────────────────────────
# El crontab del sistema envía Authorization: Bearer <CRON_SECRET> al invocar
# /api/cron/*. En el VPS se configura en /etc/$APP_SLUG/$APP_SLUG.env y systemd.
# Genera uno: openssl rand -hex 32
# Ejemplo sugerido (NO reutilizar en prod — genera el tuyo):
# CRON_SECRET=a7f3c9e2b81d4f6058a2e7c1d9b0f4a6e8c2d5f7a9b1c3e5d7f9a2b4c6d8e0f2
CRON_SECRET=

# ── Retención de datos temporales (Sesión 07) ────────────────────────────
# Días después de expiración para borrar PasswordResetToken y limpiar
# emailChangeToken/pendingEmail. Rango: 1–365. Default en dev: 7.
TEMP_TOKEN_RETENTION_DAYS=7
# Días después de updatedAt para borrar registros PaymentUpload DELETED.
# Rango: 1–365. Default en dev: 30.
DELETED_UPLOAD_RETENTION_DAYS=30
# Cuerpos de correo cifrados en la cola. Generar con openssl rand -hex 32.
# Si queda vacío se usa NEXTAUTH_SECRET; mantener estable mientras haya pendientes.
EMAIL_DELIVERY_SECRET=
# Límite agregado de unidades reservadas en pedidos aún no pagados por cuenta.
CHECKOUT_MAX_UNPAID_RESERVED_UNITS=100

# ── Datos de la tienda en correos ────────────────────────────────────────
# Sin valor por defecto: si los dejas vacíos, el pie de los correos omite esas
# líneas. Defínelos antes de enviar correos a clientes reales.
# NEXT_PUBLIC_CONTACT_PHONES=0000-0000000 · 0000-0000000
# NEXT_PUBLIC_STORE_ADDRESS=Calle y número, sector, ciudad, estado
# NEXT_PUBLIC_INSTAGRAM_HANDLE=@tu_cuenta

# --- Cashea ---
CASHEA_ENABLED=false                 # master switch del flujo automático
CASHEA_ENV=sandbox                   # sandbox | production
CASHEA_API_BASE_URL=                 # base del API privado (ej. https://external.cashea.app)
CASHEA_PRIVATE_API_KEY=              # SOLO servidor. Nunca NEXT_PUBLIC
CASHEA_EXTERNAL_CLIENT_ID=           # provisto por Cashea
CASHEA_STORE_ID=                     # id numérico de tienda Cashea
CASHEA_STORE_NAME=                   # nombre exacto autorizado de la tienda
CASHEA_MERCHANT_NAME=                # merchantName exacto autorizado
CASHEA_SDK_VERSION=1.1.19            # versión fijada del SDK web
CASHEA_RESERVATION_MINUTES=60        # ventana de reserva de inventario
CASHEA_CURRENCY=USD                  # PENDIENTE confirmar con Cashea (ver Sec. 12)
CASHEA_DELIVERY_PRICE=0              # flete a cobro a destino

# Clave pública (se expone al cliente para el SDK)
NEXT_PUBLIC_CASHEA_PUBLIC_API_KEY=
NEXT_PUBLIC_CASHEA_ENABLED=false     # espejo del flag para render condicional en cliente

# ── Capacidad por proceso Node en VPS ───────────────────────────────────
# N procesos × DATABASE_POOL_MAX debe dejar conexiones libres para cron,
# migraciones y administración dentro de PostgreSQL max_connections.
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Neon pooler no admite timeouts en startup. Configura statement_timeout y
# lock_timeout en el rol de PostgreSQL usando DIRECT_URL; el cliente mantiene
# DATABASE_STATEMENT_TIMEOUT_MS como límite de espera en todas las conexiones.
# En producción, endpoints sensibles se bloquean si Redis no está disponible.
# Mantener true al usar varios procesos/réplicas. false acepta cuota local.
RATE_LIMIT_REQUIRE_DISTRIBUTED=true
# Edad máxima de tasa configurada; permite fines de semana sin marcarla fresca indefinidamente.
EXCHANGE_RATE_MAX_AGE_HOURS=96
